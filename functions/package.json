{
  "name": "whybee-functions",
  "version": "1.0.0",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "build:watch": "tsc --watch",
    "preview": "npm run build && npm run preview:resumes && npm run preview:invites && npm run preview:serve",
    "preview:resumes": "node lib/scripts/previewResume.js",
    "preview:invites": "node lib/scripts/previewInvites.js",
    "preview:serve": "node lib/scripts/servePreview.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy:staging": "firebase deploy --only functions --project staging",
    "deploy:prod": "firebase deploy --only functions --project prod",
    "logs": "firebase functions:log",
    "logs:staging": "firebase functions:log --project staging",
    "logs:prod": "firebase functions:log --project prod"
  },
  "dependencies": {
    "@types/pdfkit": "^0.17.5",
    "axios": "^1.6.0",
    "pdf-parse": "^1.1.1",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^6.0.0",
    "openai": "^4.0.0",
    "pdfkit": "^0.17.2",
    "razorpay": "^2.9.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "firebase-functions-test": "^3.0.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.4.0"
  }
}
